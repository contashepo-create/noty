{
  "name": "supernoti-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supernoti-db",
      "database_id": "PLACEHOLDER_REPLACE_WITH_ACTUAL_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "supernoti-attachments"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_ROOM",
        "class_name": "SyncRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["SyncRoom"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
