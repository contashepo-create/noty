{
  "name": "supernoti-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supernoti-db",
      "database_id": "9de22686-6551-43ab-a56c-77565b3e2afa"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "supernoti-attachments"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
